# DEVELOPMENT ONLY: copy once; never overwrite an existing private .env.
# Generate a private random key (at least 32 characters); never commit it.
SECRET_KEY=
DATABASE_URL=
BASE_URL=http://127.0.0.1:5000

MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_ADDRESS=xentesvasilis@gmail.com
MAIL_APP_PASSWORD=

CALENDLY_SCHEDULING_URL=

FLASK_ENV=development
# Production uses a shared redis:// or rediss:// backend; dependency included.
RATELIMIT_STORAGE_URI=memory://
# Set only after identifying the public production hostname.
TRUSTED_HOSTS=

# PRODUCTION: inject through the hosting environment / secret manager.
# FLASK_ENV=production
# FLASK_DEBUG=0
# SECRET_KEY=<generate privately, never reuse test/development values>
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=verify-full
# BASE_URL=https://<public-hostname>
# TRUSTED_HOSTS=<public-hostname>
# RATELIMIT_STORAGE_URI=rediss://<redis-host>:6379/0
# MAIL_ENABLED=true
# MAIL_APP_PASSWORD=<private Gmail app password>
# CALENDLY_SCHEDULING_URL=https://calendly.com/<account>/<event>
